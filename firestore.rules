rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasExactKeys(data, reqKeys, expectedSize) {
      return data.keys().hasAll(reqKeys) && data.keys().size() == expectedSize;
    }

    function isMember(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/members/$(uid));
    }

    function getMemberData(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data;
    }

    // Role & Custom Claims Authorization Helpers (strictly verified via Firebase ID token claims)
    function isLeaderEmailDirect() {
      return isSignedIn() && (
        request.auth.token.email in [
          'sallumrazak@gmail.com',
          'mohamedmaisara.2007@gmail.com',
          'sallumceeljale@com',
          'sallumceeljale@gmail.com'
        ]
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        isLeaderEmailDirect()
      );
    }

    function isCoordinator() {
      return isSignedIn() && (
        isAdmin() ||
        ('role' in request.auth.token && request.auth.token.role == 'coordinator') ||
        ('coordinator' in request.auth.token && request.auth.token.coordinator == true)
      );
    }

    function isCoordinatorOrAdmin() {
      return isAdmin() || isCoordinator();
    }

    function isActiveMember() {
      return isSignedIn() && (
        isCoordinatorOrAdmin() ||
        (exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
         getMemberData(request.auth.uid).status == 'active')
      );
    }

    // 1. Members Collection (Private identity, email, role, status, approval data, private hours)
    match /members/{uid} {
      // Ordinary members may ONLY get their own member document.
      // Full collection list is strictly restricted to coordinators and admins.
      allow get: if isSignedIn() && (request.auth.uid == uid || isCoordinatorOrAdmin());
      allow list: if isCoordinatorOrAdmin();

      // Creation: Only admins or pending self-registration with default 'member' role and 'pending' status
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          incoming().uid == uid &&
          incoming().status == 'pending' &&
          incoming().role == 'member' &&
          (!incoming().keys().contains('totalApprovedMinutes') || incoming().totalApprovedMinutes == 0) &&
          (!incoming().keys().contains('hasCrown') || incoming().hasCrown == false)
        )
      );

      // Updating:
      // Only admins may approve, suspend, reject, or assign privileged roles and crowns.
      // Individual users may only update non-privileged fields (e.g. displayName, photoURL, bio, skills, interests, region, headline, directoryVisible, customBadge, linkedinURL)
      // and CANNOT change their own role, status, approval minutes, or crown.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == uid &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().totalApprovedMinutes == existing().totalApprovedMinutes &&
          (!existing().keys().contains('hasCrown') || incoming().hasCrown == existing().hasCrown) &&
          incoming().joinedAt == existing().joinedAt
        )
      );

      // Deletion: Only admins
      allow delete: if isAdmin();
    }

    // 2. Public Profiles Collection (Public display name, approved photo URL, bio, skills, interests, region, public headline, directoryVisible)
    match /publicProfiles/{uid} {
      // Profile can be read if visible in directory and active, or if viewed by the owner or an admin/coordinator
      allow get: if (resource.data.directoryVisible == true && resource.data.status == 'active') || (isSignedIn() && request.auth.uid == uid) || isCoordinatorOrAdmin();
      allow list: if (resource.data.directoryVisible == true && resource.data.status == 'active') || isCoordinatorOrAdmin();

      // Creation & Updates: Members can manage their own public profile (cannot escalate status or role)
      allow create: if isSignedIn() && (request.auth.uid == uid || isCoordinatorOrAdmin());
      allow update: if isSignedIn() && (
        isCoordinatorOrAdmin() ||
        (
          request.auth.uid == uid &&
          (!existing().keys().contains('role') || incoming().role == existing().role) &&
          (!existing().keys().contains('status') || incoming().status == existing().status) &&
          (!existing().keys().contains('totalApprovedMinutes') || incoming().totalApprovedMinutes == existing().totalApprovedMinutes) &&
          (!existing().keys().contains('hasCrown') || incoming().hasCrown == existing().hasCrown)
        )
      );
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // 2b. Legacy Public Directory Profiles match alias
    match /public_profiles/{uid} {
      allow get, list: if (resource.data.directoryVisible == true && resource.data.status == 'active') || (isSignedIn() && request.auth.uid == uid) || isCoordinatorOrAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // 3. Bulletin Posts
    match /posts/{postId} {
      allow get, list: if isActiveMember() || isCoordinatorOrAdmin();

      allow create: if isActiveMember() &&
                       isValidId(postId) &&
                       incoming().authorUID == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().likesCount == 0 &&
                       (incoming().category != 'Announcement' || isCoordinatorOrAdmin());

      allow update: if isActiveMember() &&
                       isValidId(postId) &&
                       (
                         // Case A: Post author edits message or category
                         (existing().authorUID == request.auth.uid &&
                          incoming().authorUID == existing().authorUID &&
                          incoming().createdAt == existing().createdAt &&
                          (incoming().category != 'Announcement' || isCoordinatorOrAdmin()))
                         ||
                         // Case B: Atomic like count update
                         incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
                       );

      allow delete: if isSignedIn() && (
        (exists(/databases/$(database)/documents/posts/$(postId)) && existing().authorUID == request.auth.uid) ||
        isCoordinatorOrAdmin()
      );

      // Likes subcollection
      match /likes/{userId} {
        allow get, list: if isActiveMember() || isCoordinatorOrAdmin();
        allow create: if isActiveMember() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().createdAt == request.time;
        allow delete: if isActiveMember() && request.auth.uid == userId;
      }
    }

    // 4. Volunteering Activities & Opportunities
    match /activities/{activityId} {
      // Ordinary active members can read published activities; coordinators/admins can read all including drafts
      allow get, list: if (isActiveMember() && resource.data.status != 'draft') || isCoordinatorOrAdmin();

      // Only coordinators and administrators can create activities (requires timestamps for schedule)
      allow create: if isCoordinatorOrAdmin() &&
                       isValidId(activityId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().startsAt is timestamp &&
                       incoming().endsAt is timestamp;

      // Only coordinators and administrators can update activities (members cannot edit any field)
      allow update: if isCoordinatorOrAdmin();

      // Only coordinators and administrators can delete activities
      allow delete: if isCoordinatorOrAdmin();

      // Signups subcollection (strictly isolates volunteer identity and protects emails)
      match /signups/{userId} {
        // Individual can view their own signup; coordinators/admins can view any
        allow get: if isSignedIn() && (request.auth.uid == userId || isCoordinatorOrAdmin());

        // Full roster listing is strictly restricted to coordinators and admins
        allow list: if isCoordinatorOrAdmin();

        // Active members can create only their own signup document, only for published activities, with server timestamp and approved fields
        allow create: if isActiveMember() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().signedUpAt == request.time &&
                         incoming().keys().hasOnly(['userId', 'signedUpAt']) &&
                         exists(/databases/$(database)/documents/activities/$(activityId)) &&
                         get(/databases/$(database)/documents/activities/$(activityId)).data.status == 'published';

        // Members can withdraw their own signup; coordinators/admins can remove signups
        allow delete: if isSignedIn() && (request.auth.uid == userId || isCoordinatorOrAdmin());

        // Signups cannot be modified once created
        allow update: if false;
      }
    }

    // 5. Shared Resource Bank
    match /resources/{resourceId} {
      allow get, list: if isActiveMember() && (
        resource.data.status == 'approved' ||
        resource.data.creatorId == request.auth.uid ||
        isCoordinatorOrAdmin()
      );

      allow create: if isActiveMember() &&
                       isValidId(resourceId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().submittedAt == request.time &&
                       incoming().url.matches('^https://.+');

      allow update: if isCoordinatorOrAdmin() || (
        isActiveMember() &&
        existing().creatorId == request.auth.uid &&
        existing().status == 'pending' &&
        incoming().creatorId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().url.matches('^https://.+')
      );

      allow delete: if isSignedIn() && (
        (exists(/databases/$(database)/documents/resources/$(resourceId)) && existing().creatorId == request.auth.uid) ||
        isCoordinatorOrAdmin()
      );
    }

    // 6. Volunteer Hours Logs (Integer minutes, private records, coordinator/admin approval workflow)
    match /hours_logs/{logId} {
      // Hour records are kept private: only the record owner or coordinator/admin can read/list
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isCoordinatorOrAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isCoordinatorOrAdmin());

      // Members may submit records only for themselves, as integer minutes, starting as pending
      allow create: if isActiveMember() &&
                       isValidId(logId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().minutes is int &&
                       incoming().minutes > 0 &&
                       incoming().minutes <= 60000 &&
                       (!incoming().keys().contains('hours')) &&
                       incoming().status == 'pending' &&
                       incoming().submittedAt == request.time;

      // Only admin or coordinator claims may approve or reject submissions; members cannot edit/approve
      allow update: if isCoordinatorOrAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().minutes == existing().minutes &&
                       incoming().status in ['approved', 'rejected', 'pending'];

      // Members may only delete their own pending records; coordinators/admins can delete any
      allow delete: if isCoordinatorOrAdmin() || (
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        existing().status == 'pending'
      );
    }

    // 7. Global Settings (Team Branding)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isCoordinatorOrAdmin();
    }

    // 8. Public Site Assets (Verified Firebase Storage URLs for branding & leadership cards)
    match /publicAssets/{assetKey} {
      // Anyone can read public site assets to display logos, banners, and leadership photos
      allow get, list: if true;

      // Only authorized administrators can publish, replace, or delete public site assets
      allow create, update, delete: if isAdmin() || (
        isSignedIn() && (
          request.auth.token.email in ['sallumrazak@gmail.com', 'mohamedmaisara.2007@gmail.com', 'sallumceeljale@com', 'sallumceeljale@gmail.com'] ||
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin'
        )
      );
    }
  }
}
