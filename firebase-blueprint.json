{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A message or announcement shared on the volunteer team bulletin board.",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "description": "The displayed name of the author."
        },
        "authorUID": {
          "type": "string",
          "description": "The Firebase Auth UID of the author."
        },
        "authorPhotoUrl": {
          "type": "string",
          "description": "Profile picture URL from Google."
        },
        "message": {
          "type": "string",
          "description": "The posting content or message "
        },
        "category": {
          "type": "string",
          "enum": ["General", "Announcement", "Idea", "Help Needed"],
          "description": "Category tag for grouping messages."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "likesCount": {
          "type": "integer",
          "description": "Number of reactions or likes."
        },
        "likes": {
          "type": "array",
          "description": "List of user UIDs who liked this post."
        }
      },
      "required": ["authorName", "authorUID", "message", "category", "createdAt", "likesCount", "likes"]
    },
    "Task": {
      "title": "Task",
      "description": "A volunteering task or event that team members can sign up for.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the volunteering task."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the task."
        },
        "location": {
          "type": "string",
          "description": "Where the volunteering occurs."
        },
        "date": {
          "type": "string",
          "description": "Calendar date of the event."
        },
        "time": {
          "type": "string",
          "description": "Time duration of the event."
        },
        "spotsTotal": {
          "type": "integer",
          "description": "Total spots available for volunteering."
        },
        "spotsFilled": {
          "type": "integer",
          "description": "Count of filled volunteer slots."
        },
        "creatorId": {
          "type": "string",
          "description": "The UID of the task creator."
        },
        "creatorName": {
          "type": "string",
          "description": "The name of the task creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation."
        }
      },
      "required": ["title", "description", "location", "date", "time", "spotsTotal", "spotsFilled", "creatorId", "creatorName", "createdAt"]
    },
    "TaskSignup": {
      "title": "TaskSignup",
      "description": "A signup record representing a user joining a task.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the signing up user."
        },
        "userName": {
          "type": "string",
          "description": "The displayed name of the volunteer."
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the volunteer."
        },
        "signedUpAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when joined."
        }
      },
      "required": ["userId", "userName", "userEmail", "signedUpAt"]
    },
    "Member": {
      "title": "Member",
      "description": "A student or school volunteer who joined the team.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID of the member."
        },
        "name": {
          "type": "string",
          "description": "Name of the volunteer."
        },
        "email": {
          "type": "string",
          "description": "Email address of the volunteer."
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the member first logged in."
        }
      },
      "required": ["uid", "name", "email", "joinedAt"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Shared educational materials or resources submitted by volunteers.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Study Aid", "Worksheets", "Volunteering Guide", "Event Template", "Educational Link", "Other"] },
        "url": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "url", "creatorId", "creatorName", "createdAt"]
    },
    "VolunteerHourLog": {
      "title": "VolunteerHourLog",
      "description": "Recorded volunteer activity logs tracking names, roles, hours, and description of duty.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "hours": { "type": "integer" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "userEmail", "hours", "date", "description", "createdAt"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Bulletin board posts collection"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Volunteering tasks and events collection"
    },
    "/tasks/{taskId}/signups/{userId}": {
      "schema": "TaskSignup",
      "description": "Volunteer signup records under each task"
    },
    "/members/{uid}": {
      "schema": "Member",
      "description": "Volunteers who have joined the community"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Collaborative resource bank documents"
    },
    "/hours_logs/{logId}": {
      "schema": "VolunteerHourLog",
      "description": "Logs tracking volunteered student hours"
    }
  }
}
